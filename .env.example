# ---------------------------------------------------------------------------
# OwO Bot environment
# Copy this file to `.env` and fill in the values. NEVER commit `.env`.
# Compatible with the legacy `secret/env` layout: if `.env` is missing, the bot
# falls back to `./secret/env`.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------
BOT_TOKEN=
# Only needed by `npm run verify:commands`-style tooling / registerAppCommands
CLIENT_ID=
CLIENT_SECRET=

# --- Authorization (no privileged id ships in the repository) ---------------
# Comma separated Discord user ids. Empty => owner-only commands (eval,
# addcowoncy, giveall, broadcastEval, ...) are disabled for everyone.
OWNER_IDS=
# Staff roles, only honoured inside MOD_CHANNEL_IDS
ADMIN_ROLE_IDS=
MANAGER_ROLE_IDS=
HELPER_ROLE_IDS=
# Comma separated channel ids where staff commands may be used at all
MOD_CHANNEL_IDS=
# Optional: channels the giveaway system may post in
GIVEAWAY_CHANNEL_IDS=

# --- Runtime flags ----------------------------------------------------------
# Default: false. While true the bot only answers in DEBUG_WHITELIST guilds.
DEBUG=false
DEBUG_WHITELIST=
# Default: false. Enables owner-only `eval` / `broadcastEval`.
ALLOW_EVAL=false
# Exit the process on an uncaught exception so the sharder respawns it.
EXIT_ON_FATAL=true
PREFIX=o
# Number of sharder clusters (default 60, capped at 200)
CLUSTERS=
# error | warn | info | debug
LOG_LEVEL=info
# Enables StatsD/Datadog forwarding; in-process counters always work.
METRICS_ENABLED=false

# --- MySQL / MariaDB --------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=owo
MYSQL_PASS=
MYSQL_DATABASE=owo
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_IDLE_TIMEOUT_MS=60000
MYSQL_QUERY_TIMEOUT_MS=30000
MYSQL_TRANSACTION_TIMEOUT_MS=10000
# Required by existing multi-statement battle/team queries. Only set to false
# after those call sites are migrated (see SECURITY.md).
MYSQL_MULTIPLE_STATEMENTS=true

# --- Redis ------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# --- Sharder / inter-service (required in production) -----------------------
SHARDER_HOST=
SHARDER_SERVER=
SHARDER_PORT=
SHARDER_PASS=
STREAM_SOCKET=
STREAM_TOKEN=
SNAIL_SOCKET=
SNAIL_TOKEN=

# --- Optional integrations --------------------------------------------------
DBL_TOKEN=
WEEBSH_TOKEN=
WEEBSH_URL=https://api.weeb.sh
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_ACCESS_TOKEN=
IMAGE_GEN_URL=
IMAGE_GEN_API=
IMAGE_GEN_PASS=
SITE_API=
SITE_URL=
SITE_PASS=
NEO4J_HOST=
NEO4J_PASS=
INFLUXDB_HOST=
INFLUXDB_PASS=
GEN_HOST=
GEN_ASSET_HOST=
GEN_API_HOST=
GEN_PASS=

# --- Timeouts (milliseconds) ------------------------------------------------
HTTP_TIMEOUT_MS=15000
MATH_TIMEOUT_MS=3000
TRANSLATE_TIMEOUT_MS=8000
URBAN_DICTIONARY_TIMEOUT_MS=8000
HEALTHCHECK_TIMEOUT_MS=3000
