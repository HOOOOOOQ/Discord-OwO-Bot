# ---------------------------------------------------------------------------
# OCEAN Bot environment
# Copy this file to `.env` and fill it in. NEVER commit `.env`.
# If `.env` is missing the bot falls back to the legacy `./secret/env` file.
#
# Database: the bot needs **MongoDB Atlas only**. MySQL, MariaDB and Redis are
# no longer used — do not install them, do not set DATABASE_URL/REDIS_URL.
# ---------------------------------------------------------------------------

# ===========================================================================
# MINIMAL — cukup dua baris ini untuk membuat bot online
# ===========================================================================
BOT_TOKEN=
# Isi token SAJA (tanpa awalan "Bot ", tanpa tanda kutip, tanpa newline).
# Nilai yang tersalin dengan awalan "Bot " dinormalkan otomatis dan dilaporkan
# di panel ([CONFIG] BOT_TOKEN normalised), tapi simpan yang bersih dari awal.

MONGODB_URI=
# Connection string MongoDB Atlas, contoh:
#   mongodb+srv://ocean:PASSWORD@cluster0.abcde.mongodb.net/ocean?retryWrites=true&w=majority
#
# Cara cepat:
#   1. https://cloud.mongodb.com → Create → Free (M0)
#   2. Database Access → Add New Database User → catat username & password
#   3. Network Access → Add IP Address → Allow Access from Anywhere (0.0.0.0/0)
#      (host Pterodactyl punya IP yang berubah-ubah)
#   4. Clusters → Connect → Drivers → Node.js → salin connection string
#   5. Ganti <password>, dan pastikan nama database ada sebelum "?" (mis. /ocean)
#
# Password yang mengandung @ : ; / harus di-encode (%40 %3A %3B %2F).

PREFIX=o
# Prefix default. Bisa diubah per server dengan `o prefix <baru>`.
# `ohelp` dan `o help` dua-duanya bisa dipakai.

CLUSTERS=1
# Jumlah proses cluster. Default sekarang 1 (satu proses, aman untuk panel 2 GB).
# Naikkan hanya kalau server besar: tiap cluster = satu proses Node penuh.

# ===========================================================================
# OPSIONAL — tidak perlu diubah untuk deploy normal
# ===========================================================================

# --- Database (opsional) ----------------------------------------------------
# Nama database. Kosong = nama dari URI di atas, atau "ocean".
MONGODB_DB=ocean
# Nama database lama (MySQL) TIDAK dipakai lagi.
MONGODB_TIMEOUT_MS=15000
MONGODB_CONNECT_ATTEMPTS=5
MONGODB_POOL_SIZE=20
MONGO_QUERY_TIMEOUT_MS=30000
MONGO_TRANSACTION_TIMEOUT_MS=15000

# --- Authorization (tidak ada id istimewa yang ikut di repo) ----------------
# Kosong = tidak ada owner (eval dan command owner lain mati)
OWNER_IDS=
ADMIN_ROLE_IDS=
MANAGER_ROLE_IDS=
HELPER_ROLE_IDS=
MOD_CHANNEL_IDS=
GIVEAWAY_CHANNEL_IDS=

# --- Cowoncy grants (`o grant @user 1000`) ----------------------------------
# Kosong = hanya OWNER_IDS yang boleh menambah cowoncy.
COWONCY_ADMIN_IDS=
COWONCY_ADMIN_ROLE_IDS=
COWONCY_GRANT_MAX=1000000000

# --- Runtime flags ----------------------------------------------------------
DEBUG=false
# true = bot HANYA menjawab guild di DEBUG_WHITELIST. Kalau whitelist kosong,
# bot tidak menjawab siapa pun. Untuk bot publik gunakan DEBUG=false.
DEBUG_WHITELIST=
# true = cetak alur setiap pesan ([CMD] message_received / prefix_matched / …)
COMMAND_DEBUG=false
# false = eval/broadcastEval mati (biarkan false di server publik)
ALLOW_EVAL=false
EXIT_ON_FATAL=true
# false = master tetap hidup walau cluster mati berulang kali (tidak disarankan:
# panel akan menampilkan "running" padahal bot tidak pernah online).
EXIT_ON_CRASH_LOOP=true
# error | warn | info | debug
LOG_LEVEL=info
METRICS_ENABLED=false

# --- Kredensial Discord lanjutan (biasanya tidak dipakai) -------------------
CLIENT_ID=
CLIENT_SECRET=

# --- Presence (status online + aktivitas di Discord) ------------------------
# online | idle | dnd | invisible  (invisible membuat bot tampak offline!)
BOT_STATUS=online
# playing | watching | listening | competing | streaming | custom
BOT_ACTIVITY_TYPE=watching
# Placeholder yang didukung: {guilds} {users} {shards} {prefix}
# Catatan: teks activity TIDAK bisa diklik di Discord; link server tampil
# sebagai link yang bisa diklik di embed `o help` / `o invite`.
BOT_ACTIVITY_TEXT=discord.gg/666family
# Wajib untuk BOT_ACTIVITY_TYPE=streaming (URL twitch/youtube)
BOT_ACTIVITY_URL=
# Terapkan ulang presence tiap N detik (0 = hanya saat ready). Berguna kalau
# memakai {guilds}/{users} agar angkanya ikut berubah.
BOT_PRESENCE_REFRESH_SEC=0

# --- Gateway / jaringan -----------------------------------------------------
# Lookup DNS pakai IPv4 dulu (ws tidak punya Happy Eyeballs)
# GATEWAY_IPV4_FIRST=true
# GATEWAY_HANDSHAKE_TIMEOUT_MS=20000
# GATEWAY_CONNECT_TIMEOUT_MS=15000
# GATEWAY_PROBE_ON_BOOT=true
# Berapa kali pembukaan gateway dicoba sebelum bot menyerah dan keluar dengan
# kode 1 (biar panel bisa merestart, bukan menggantung diam-diam).
# GATEWAY_CONNECT_ATTEMPTS=6
# Batas waktu tiap hook shutdown saat panel mengirim SIGTERM.
# SHUTDOWN_HOOK_TIMEOUT_MS=5000

# --- Gateway intents --------------------------------------------------------
# MESSAGE CONTENT INTENT bersifat privileged: nyalakan juga di Developer Portal
# (Bot > Privileged Gateway Intents > Message Content Intent = ON).
# auto = minta hanya kalau portal mengizinkan, on = selalu minta,
# off = jangan minta (bot online tapi tidak bisa membaca command).
ERIS_MESSAGE_CONTENT=auto
# Override bitmask intent sepenuhnya (nama dipisah koma atau angka).
ERIS_INTENTS=

# --- Sharding ---------------------------------------------------------------
# Kosong = jumlah shard diambil dari rekomendasi Discord (GET /gateway/bot).
SHARDS=
SHARD_FIRST=
SHARD_LAST=

# --- Optimasi resource ------------------------------------------------------
# Matikan tracing agent (dd-trace) untuk menghemat RAM di panel kecil.
DD_TRACE_ENABLED=true

# --- Integrasi opsional -----------------------------------------------------
# Kosong = fitur yang memakainya mati dan TIDAK ada koneksi jaringan sama sekali.
# INFLUXDB_HOST/INFLUXDB_PASS: sink log milik upstream, tidak dipakai di sini.
# StatsD/Datadog hanya aktif kalau METRICS_ENABLED=true (opsional, STATSD_HOST).
DBL_TOKEN=
WEEBSH_TOKEN=
WEEBSH_URL=https://api.weeb.sh
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_ACCESS_TOKEN=
# Dipakai oleh command battle/memegen (kosong = command memakai canvas lokal).
SITE_URL=
GEN_HOST=
GEN_API_HOST=
GEN_PASS=
# Sink log upstream; tidak dipakai lagi (dibiarkan agar panel lama tidak error).
INFLUXDB_HOST=
INFLUXDB_PASS=

# --- Timeouts (milidetik) ---------------------------------------------------
HTTP_TIMEOUT_MS=15000
MATH_TIMEOUT_MS=3000
TRANSLATE_TIMEOUT_MS=8000
URBAN_DICTIONARY_TIMEOUT_MS=8000
HEALTHCHECK_TIMEOUT_MS=3000
