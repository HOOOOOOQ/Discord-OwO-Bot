# ---------------------------------------------------------------------------
# OCEAN Bot environment
# Copy this file to `.env` and fill it in. NEVER commit `.env`.
# If `.env` is missing the bot falls back to the legacy `./secret/env` file.
#
# Database: this bot uses **MySQL / MariaDB** (schema in
# secret/CREATE-OWO-TABLES.sql) plus **Redis**. MongoDB is not used.
# ---------------------------------------------------------------------------

# ===========================================================================
# MINIMAL — 6 variabel ini sudah cukup untuk menjalankan bot
# ===========================================================================
BOT_TOKEN=
# Isi token SAJA (tanpa awalan "Bot ", tanpa tanda kutip, tanpa newline).
# Nilai yang tersalin dengan awalan "Bot " dinormalkan otomatis dan dilaporkan
# di panel ([CONFIG] BOT_TOKEN normalised), tapi simpan yang bersih dari awal.
# Kosong = tidak ada owner (eval dan command owner lain mati)
OWNER_IDS=

# PENTING: isi dua URL di bawah sesuai servermu. Kalau kamu memakai variabel
# manual MYSQL_*/REDIS_* (atau variabel panel), hapus/comment baris URL ini —
# URL selalu menang atas variabel manual.
# MySQL/MariaDB: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Karakter khusus di password harus di-encode (%40 untuk @, %3A untuk :).
DATABASE_URL=mysql://owo:password@172.18.0.1:3306/owo
# Redis: redis://:PASSWORD@HOST:PORT/DB  (pakai rediss:// kalau TLS)
REDIS_URL=redis://:password@172.18.0.1:6379/0

PREFIX=o
# Jumlah proses cluster: 1-2 cukup untuk bot kecil. Default repo 60 (OOM di panel kecil).
CLUSTERS=2

# ===========================================================================
# OPSIONAL — tidak perlu diubah untuk deploy normal
# ===========================================================================

# --- Authorization (tidak ada id istimewa yang ikut di repo) ----------------
# Staff roles, hanya berlaku di channel MOD_CHANNEL_IDS
ADMIN_ROLE_IDS=
MANAGER_ROLE_IDS=
HELPER_ROLE_IDS=
MOD_CHANNEL_IDS=
GIVEAWAY_CHANNEL_IDS=

# --- Cowoncy grants (`o grant @user 1000`) ----------------------------------
# Kosong = hanya OWNER_IDS yang boleh menambah cowoncy.
COWONCY_ADMIN_IDS=
COWONCY_ADMIN_ROLE_IDS=
COWONCY_GRANT_MAX=1000000000

# --- Runtime flags ----------------------------------------------------------
DEBUG=false
DEBUG_WHITELIST=
# false = eval/broadcastEval mati (biarkan false di server publik)
ALLOW_EVAL=false
EXIT_ON_FATAL=true
# error | warn | info | debug
LOG_LEVEL=info
METRICS_ENABLED=false

# --- Kredensial Discord lanjutan (biasanya tidak dipakai) -------------------
CLIENT_ID=
CLIENT_SECRET=

# --- MySQL/MariaDB manual (alternatif DATABASE_URL, dipakai kalau URL kosong)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASS=
MYSQL_DATABASE=owo
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_IDLE_TIMEOUT_MS=60000
MYSQL_QUERY_TIMEOUT_MS=30000
MYSQL_TRANSACTION_TIMEOUT_MS=10000
# Dibutuhkan query multi-statement battle/team lama. Jangan set false sebelum
# call site-nya dimigrasi (lihat SECURITY.md).
MYSQL_MULTIPLE_STATEMENTS=true

# --- Redis manual (alternatif REDIS_URL) ------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
REDIS_TLS=false

# --- Presence (status online + aktivitas di Discord) ------------------------
# online | idle | dnd | invisible  (invisible membuat bot tampak offline!)
BOT_STATUS=online
# playing | watching | listening | competing | streaming | custom
BOT_ACTIVITY_TYPE=playing
# Placeholder yang didukung: {guilds} {users} {shards} {prefix}
BOT_ACTIVITY_TEXT=o help
# Wajib untuk BOT_ACTIVITY_TYPE=streaming (URL twitch/youtube)
BOT_ACTIVITY_URL=
# Terapkan ulang presence tiap N detik (0 = hanya saat ready). Berguna kalau
# memakai {guilds}/{users} agar angkanya ikut berubah.
BOT_PRESENCE_REFRESH_SEC=0

# --- Gateway intents --------------------------------------------------------
# MESSAGE CONTENT INTENT bersifat privileged: nyalakan juga di Developer Portal
# (Bot > Privileged Gateway Intents). auto = minta hanya kalau portal mengizinkan.
# on = selalu minta (portal wajib nyala), off = jangan minta (bot online tapi
# tidak bisa membaca command).
ERIS_MESSAGE_CONTENT=auto
# Override bitmask intent sepenuhnya (nama dipisah koma atau angka).
# Contoh: ERIS_INTENTS=allNonPrivileged,messageContent
ERIS_INTENTS=

# --- Sharding ---------------------------------------------------------------
# Kosong = jumlah shard diambil dari rekomendasi Discord (GET /gateway/bot).
# Isi manual hanya kalau kamu ingin memaksa pembagian tertentu.
SHARDS=
SHARD_FIRST=
SHARD_LAST=

# --- Sharder / inter-service (OPSIONAL) -------------------------------------
# Service privat milik OwO upstream. Instalasi mandiri tidak butuh ini; biarkan
# kosong dan bot memakai rekomendasi shard dari Discord.
SHARDER_HOST=
SHARDER_SERVER=
SHARDER_PORT=
SHARDER_PASS=
STREAM_SOCKET=
STREAM_TOKEN=
SNAIL_SOCKET=
SNAIL_TOKEN=

# --- Optimasi resource ------------------------------------------------------
# Matikan tracing agent (dd-trace) untuk menghemat RAM di panel kecil.
DD_TRACE_ENABLED=true

# --- Integrasi opsional -----------------------------------------------------
DBL_TOKEN=
WEEBSH_TOKEN=
WEEBSH_URL=https://api.weeb.sh
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_ACCESS_TOKEN=
IMAGE_GEN_URL=
IMAGE_GEN_API=
IMAGE_GEN_PASS=
SITE_API=
SITE_URL=
SITE_PASS=
NEO4J_HOST=
NEO4J_PASS=
INFLUXDB_HOST=
INFLUXDB_PASS=
GEN_HOST=
GEN_ASSET_HOST=
GEN_API_HOST=
GEN_PASS=

# --- Timeouts (milidetik) ---------------------------------------------------
HTTP_TIMEOUT_MS=15000
MATH_TIMEOUT_MS=3000
TRANSLATE_TIMEOUT_MS=8000
URBAN_DICTIONARY_TIMEOUT_MS=8000
HEALTHCHECK_TIMEOUT_MS=3000
