{
	"name": "ocean-bot",
	"version": "1.0.0",
	"description": "OCEAN, a Discord bot for animal collection, economy and battles.",
	"main": "index.js",
	"scripts": {
		"lint": "npx eslint .",
		"lint:fix": "npx eslint --fix .",
		"prettier": "npx prettier --check .",
		"prettier:fix": "npx prettier --write .",
		"format": "npm run lint:fix && npm run prettier:fix",
		"test": "node --test \"test/*.test.js\"",
		"verify:commands": "node scripts/verifyCommands.js",
		"checkCircular": "./node_modules/dpdm/lib/bin/dpdm.js --exit-code circular:1 ./src/owo.js",
		"audit": "npm audit --omit=dev"
	},
	"dependencies": {
		"@2toad/profanity": "^1.3.0",
		"@zuzak/owo": "^1.9.0",
		"axios": "^1.21.1",
		"bad-words": "^3.0.3",
		"canvas": "^2.11.2",
		"dblapi.js": "^2.4.0",
		"dd-trace": "^0.31.4",
		"dotenv": "^10.0.0",
		"eris-sharder": "https://github.com/ChristopherBThai/eris-sharder.git#b82220e130c298fe40d6c41b133151288b149711",
		"eventemitter3": "^4.0.4",
		"mathjs": "^6.6.5",
		"merge-images": "https://github.com/ChristopherBThai/merge-images.git#430c3ab6df264e8660c4c9b35ef22772774d0bab",
		"mysql": "^2.18.1",
		"namor": "^2.0.2",
		"node-dogstatsd": "0.0.7",
		"node-vibrant": "^3.1.5",
		"parse-duration": "^0.4.4",
		"patreon": "^0.4.1",
		"patreon-discord": "^0.0.5",
		"pluralize": "^8.0.0",
		"random-number-csprng": "^1.0.2",
		"redis": "^2.8.0",
		"require-dir": "^1.2.0",
		"socket.io-client": "^4.1.3",
		"statsd-client": "^0.4.5",
		"systeminformation": "^5.33.23",
		"workerpool": "^6.1.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ChristopherBThai/Discord-OwO-Bot.git"
	},
	"author": "Christopher Thai",
	"license": "CC-BY-NC-SA-4.0",
	"bugs": {
		"url": "https://github.com/ChristopherBThai/Discord-OwO-Bot/issues"
	},
	"homepage": "https://github.com/ChristopherBThai/Discord-OwO-Bot#readme",
	"devDependencies": {
		"dpdm": "^3.13.1",
		"eslint": "^8.29.0",
		"eslint-config-prettier": "^8.5.0",
		"prettier": "^2.8.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
